# Copy this file to .env and fill in real values.
# Never commit .env or expose GEMINI_API_KEY in templates, JavaScript or logs.

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set to 1 only behind HTTPS in production.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
# Optional development convenience; never enable in production.
AUTO_LOGIN_DEV=0

# ── Database ──────────────────────────────────────────────────────────────
# Default: SQLite at db.sqlite3.  Set USE_MYSQL=1 for MariaDB 10.11+/MySQL.
USE_MYSQL=0
MYSQL_DATABASE=motor_assistant_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ── Shared cache for rate limiting ────────────────────────────────────────
# LocMemCache is per-process. For multiple workers use the database cache:
#   DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
#   DJANGO_CACHE_LOCATION=jarvis_rate_limit_cache
# then run: python manage.py createcachetable
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=jarvis-rate-limits

# ── Gemini / AI ───────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Model availability and limits differ by account. Check your account first.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=3
# Application-side daily request budget, not a claim about Google's quota.
GEMINI_DAILY_REQUEST_LIMIT=1500
GEMINI_INPUT_IMAGE_SUPPORTED=1
AI_EXPLANATION_LEVEL=beginner
AI_PROVIDER=gemini
# Only for an OpenAI-compatible endpoint:
AI_API_BASE_URL=
AI_API_KEY=

# ── Assistant and uploads ─────────────────────────────────────────────────
ASSISTANT_MAX_CONTEXT_TURNS=12
ASSISTANT_SUMMARY_TRIGGER_TURNS=10
ASSISTANT_MAX_MESSAGE_CHARS=2000
IMAGE_UPLOAD_MAX_BYTES=8388608
IMAGE_UPLOAD_MAX_PIXELS=20000000
IMAGE_UPLOAD_MAX_DIMENSION=1800
CHAT_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=10
